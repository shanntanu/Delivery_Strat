DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local Postgres: the full raw archive (every symbol, no liquidity filter).
# Only used by local scripts (backfill, detect-actions, compute-universe) —
# never by the deployed app or GitHub Actions. See DATA_SOURCES.md.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strat
# Optional. Gates /admin (corporate action review, scan trigger) behind HTTP
# Basic Auth — CLAUDE.md §12 point 7. Unset locally is fine (no-op, see
# middleware.ts); set this in Vercel's env vars for the deployed app.
ADMIN_PASSWORD=
